{
  "id": "com.deltabrix.advancedalign",
  "name": "Advanced Align",
  "version": "1.0.1",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "gapPanel",
      "label": "Advanced Align",
      "icons": [
        { "width": 23, "height": 23, "path": "icon/icon_23x23.png", "scale": 1 },
        { "width": 46, "height": 46, "path": "icon/icon_46x46.png", "scale": 2 }
      ],
      "minimumSize": {
        "width": 200,
        "height": 200
      },
      "maximumSize": {
        "width": 400,
        "height": 800
      },
      "preferredDockedSize": {
        "width": 240,
        "height": 300
      },
      "preferredFloatingSize": {
        "width": 240,
        "height": 300
      }
    }
  ],
  "icons": [
    { "width": 24, "height": 24, "path": "icon/icon_24x24.png", "scale": 1, "species": ["pluginList"] },
    { "width": 48, "height": 48, "path": "icon/icon_48x48.png", "scale": 2, "species": ["pluginList"] },
    { "width": 96, "height": 96, "path": "icon/icon_96x96.png", "scale": 1, "species": ["pluginList"] },
    { "width": 192, "height": 192, "path": "icon/icon_192x192.png", "scale": 2, "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin",
    "allowCodeGenerationFromStrings": true
  }
}